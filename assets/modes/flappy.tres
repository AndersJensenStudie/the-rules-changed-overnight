[gd_resource type="Resource" script_class="ModeSettings" format=3]

[ext_resource type="Script" path="res://mode_settings.gd" id="1_script"]
[ext_resource type="SpriteFrames" path="res://assets/animations/flappy_frames.tres" id="2_frames"]
