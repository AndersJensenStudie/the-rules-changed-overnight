max_gap_seconds = 1.8
night_y_range = Vector2(60, 180)
flight = true
flap_velocity = 190.0
flight_gravity = 700.0
max_fall_speed = 300.0
floor_kills = true
entry_hover_time = 0.5
flap_tilt_degrees = -25.0
dive_tilt_degrees = 70.0
dive_tilt_speed = 200.0
backdrop_frames = ExtResource("3_backdrop")
ground_color = Color(0.33, 0.33, 0.33, 1)
label_color = Color(0.33, 0.33, 0.33, 1)
music = ExtResource("4_music")
